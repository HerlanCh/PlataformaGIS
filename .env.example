# Copia este archivo a .env y ajusta los valores. La API no arranca si falta una variable obligatoria.

# --- API ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Base de datos local levantada con `docker compose up -d`
DATABASE_URL=postgres://gis:gis@localhost:5433/gis
# Origen permitido para la PWA
CORS_ORIGIN=http://localhost:5173
# Clave de los JWT, de al menos 32 caracteres. Obligatoria en producción; en desarrollo hay una por defecto.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Clave anterior durante una rotación: sus tokens se aceptan hasta que venzan.
JWT_SECRET_ANTERIOR=
# Vida de un token, en segundos (24 h por defecto)
JWT_DURACION_S=86400
# Solicitudes por minuto y por IP
LIMITE_POR_MINUTO=300

# --- Interruptores de módulos opcionales (true | false) ---
FEATURE_SUBSCRIPTIONS=false
FEATURE_NOTIFICATIONS=false
FEATURE_HEATMAP=false
FEATURE_MODERATION=false
FEATURE_OPEN_DATA=false
FEATURE_CLASSIFIER=false

# --- Web (Vite) ---
VITE_API_URL=http://localhost:3000

# --- Herramientas locales ---
# Usada por el servidor MCP de solo lectura definido en .mcp.json
DATABASE_URL_READONLY=postgres://gis:gis@localhost:5433/gis
