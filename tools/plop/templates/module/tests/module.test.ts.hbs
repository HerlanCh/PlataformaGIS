import { describe, expect, it } from 'vitest';
import { {{camelCase name}}Modulo } from '../index.js';

describe('módulo {{name}}', () => {
  it('expone su nombre', () => {
    expect({{camelCase name}}Modulo.nombre).toBe('{{name}}');
  });

  it('se registra sin errores', async () => {
    const registrar = async () =>
      {{camelCase name}}Modulo.registrar({} as never, {} as never, {} as never);

    await expect(registrar()).resolves.toBeUndefined();
  });
});
