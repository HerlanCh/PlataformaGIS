@startuml modelo-datos
' Modelo entidad-relación de la Plataforma GIS (Fase 3).
' Derivado del modelo de dominio de la Fase 2. El detalle de cada columna está en diccionario-datos.md.
' Las tablas y columnas están en español; los módulos conservan su nombre en inglés, como en el código.
' Para verlo: extensión PlantUML de VS Code o https://www.plantuml.com/plantuml

title Modelo entidad-relación — Plataforma GIS de alerta temprana

hide circle
hide methods
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor White
  BorderColor #444444
  ArrowColor #444444
}

package "platform — plataforma (compartido)" #F4F4F4 {
  entity "eventos_salida" as eventos {
    * id : uuid <<PK>>
    --
    * tipo : text
    * contenido : jsonb
    * creado_en : timestamptz
    publicado_en : timestamptz
  }
}

package "identity — identidad" #EAF2FB {
  entity "usuarios" as usuarios {
    * id : uuid <<PK>>
    --
    * hash_dispositivo : text <<UQ>>
    id_telegram : text <<UQ>>
    * rol : text
    * creado_en : timestamptz
  }
}

package "reports — reportes" #EAF7EA {
  entity "categorias" as categorias {
    * codigo : text <<PK>>
    --
    * nombre : text
    * ttl_minutos : integer
    * radio_duplicado_m : integer
    * es_sensible : boolean
  }

  entity "reportes" as reportes {
    * id : uuid <<PK>>
    --
    * codigo_categoria : text <<FK>>
    * id_autor : uuid <<ref>>
    * estado : text
    * ttl_minutos : integer
    * extensiones : integer
    motivo_rechazo : text
    * creado_en : timestamptz
    * caduca_en : timestamptz
    * ubicacion : geometry(Point, 4326)
    * ubicacion_publica : geometry(Point, 4326)
    * clave_idempotencia : text <<UQ>>
  }
}

package "verification — verificación" #FFF6E0 {
  entity "votos" as votos {
    * id_reporte : uuid <<PK>> <<ref>>
    * id_usuario : uuid <<PK>> <<ref>>
    --
    * valor : text
    * peso : numeric(3, 2)
    * creado_en : timestamptz
  }

  entity "reputaciones" as reputaciones {
    * id_usuario : uuid <<PK>> <<ref>>
    --
    * puntaje : numeric(3, 2)
    ultima_penalizacion_en : timestamptz
    * actualizado_en : timestamptz
  }
}

package "subscriptions — suscripciones (opcional)" #F6ECFA {
  entity "zonas_suscritas" as zonas {
    * id : uuid <<PK>>
    --
    * id_usuario : uuid <<ref>>
    * centro : geography(Point, 4326)
    * radio_m : integer
    * categorias : text[] <<ref>>
    * creado_en : timestamptz
  }
}

package "moderation — moderación (opcional)" #FBECEC {
  entity "acciones_moderacion" as acciones {
    * id : uuid <<PK>>
    --
    * id_reporte : uuid <<ref>>
    * id_moderador : uuid <<ref>>
    * accion : text
    motivo : text
    * creado_en : timestamptz
  }
}

' Relación con clave foránea: ambas tablas son del mismo módulo.
categorias ||--o{ reportes : clasifica

' Relaciones lógicas entre módulos: se guarda el identificador, sin clave foránea (ADR-001).
usuarios ||..o{ reportes : "autor (id_autor)"
usuarios ||..o| reputaciones : "tiene"
usuarios ||..o{ votos : "emite"
reportes ||..o{ votos : "recibe"
usuarios ||..o{ zonas : "suscribe"
reportes ||..o{ acciones : "es moderado en"
usuarios ||..o{ acciones : "modera (id_moderador)"

legend right
  | Símbolo | Significado |
  | * | Columna obligatoria (NOT NULL) |
  | <<PK>> | Clave primaria |
  | <<UQ>> | Valor único |
  | <<FK>> | Clave foránea, dentro del mismo módulo |
  | <<ref>> | Identificador de otro módulo, sin clave foránea (ADR-001) |
  | línea continua | Relación con clave foránea |
  | línea punteada | Relación lógica entre módulos |
endlegend

@enduml
