{
  "name": "plataforma-gis",
  "version": "2.12.2",
  "private": true,
  "description": "Plataforma GIS de alerta temprana para La Paz y El Alto",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "test": "vitest run --coverage --testTimeout=20000 --hookTimeout=30000",
    "test:watch": "vitest --testTimeout=20000 --hookTimeout=30000",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "prepare": "husky",
    "gen:module": "plop module",
    "postgen:module": "pnpm sync:modules && pnpm install",
    "sync:modules": "node tools/modules/sync-modules.mjs",
    "duplication": "jscpd apps packages tools",
    "db:migrate": "pnpm --filter @gis/api run db:migrate",
    "db:generate": "pnpm -r --if-present run db:generate",
    "seed:load": "pnpm --filter @gis/api run seed:load",
    "moderador:ascender": "pnpm --filter @gis/api run moderador:ascender",
    "datos-abiertos:cargar": "pnpm --filter @gis/api run datos-abiertos:cargar",
    "clasificador:exportar": "pnpm --filter @gis/api run clasificador:exportar",
    "clasificador:evaluar": "pnpm --filter @gis/api run clasificador:evaluar",
    "perf:espacial": "pnpm --filter @gis/api run perf:espacial",
    "gen:api": "pnpm --filter @gis/api run gen:api && pnpm --filter @gis/api-client run gen",
    "carga:difusion": "pnpm --filter @gis/api run carga:difusion",
    "fiabilidad:reinicio": "pnpm --filter @gis/api run fiabilidad:reinicio"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.15.1",
    "@resvg/resvg-js": "2.6.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "lint-staged": "^17.6.0",
    "plop": "^4.0.5",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.3",
    "yaml": "2.9.1"
  }
}
